    # Skills & Adapters
    "skills/human-ui/SKILL.md",
    ".agent/skills/human-ui/SKILL.md",
    ".agent/rules/human-ui.md",
    ".claude/commands/human-ui.md",
    ".cursor/rules/human-ui.mdc",
    ".cursor/skills/human-ui/SKILL.md",
    ".github/copilot-instructions.md",
    ".github/prompts/human-ui.prompt.md",
    ".windsurf/rules/human-ui.md",
    ".windsurf/workflows/human-ui.md"
]

def main():
    print("==================================================")
    print(" Human UI Engineering — Documentation Validator   ")
    print("==================================================")
    errors = []

    print(f"\nVerifying {len(CORE_FILES)} architecture files...")
    for rel_path in CORE_FILES:
        full_path = os.path.join(REPO_ROOT, rel_path)
        if not os.path.exists(full_path):
            errors.append(f"MISSING FILE: {rel_path}")
        else:
            size = os.path.getsize(full_path)
            if size < 50:
                errors.append(f"FILE TOO SMALL / EMPTY: {rel_path} ({size} bytes)")

    if errors:
        print(f"\n❌ FAILED with {len(errors)} error(s):")
        for err in errors:
            print(f"  - {err}")
        return 1
    else:
        print(f"  ✓ All {len(CORE_FILES)} documentation files are verified and populated.")
        print("\n✅ DOCUMENTATION INTEGRITY VERIFIED!")
        return 0

if __name__ == "__main__":
    sys.exit(main())
