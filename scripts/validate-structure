#!/usr/bin/env python3
"""
Human Flutter Engineering — Structural Validator
Verifies:
1. Agent entry points properly reference canonical instructions and skills.
2. Canonical Flutter skill has valid YAML frontmatter and all reference modules.
3. Official Antigravity workspace skill location exists and delegates cleanly.
"""

import os
import sys

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

AGENT_ENTRIES = [
    ("CLAUDE.md", "AGENTS.md"),
    ("GEMINI.md", "AGENTS.md"),
    (".github/copilot-instructions.md", "AGENTS.md"),
    (".github/prompts/human-flutter.prompt.md", "AGENTS.md"),
    (".cursor/rules/human-flutter.mdc", "AGENTS.md"),
    (".cursor/skills/human-flutter/SKILL.md", "skills/human-flutter/SKILL.md"),
    (".agent/rules/human-flutter.md", "AGENTS.md"),
    (".agent/skills/human-flutter/SKILL.md", "skills/human-flutter/SKILL.md"),
    (".agents/rules/human-flutter.md", "AGENTS.md"),
    (".agents/skills/human-flutter/SKILL.md", "skills/human-flutter/SKILL.md"),
    (".claude/commands/human-flutter.md", "AGENTS.md"),
    (".windsurf/rules/human-flutter.md", "AGENTS.md"),
]

EXPECTED_REFERENCES = [
    # Core 28 Reference Modules
    "permission-system.md",
    "project-structure.md",
    "flutter-architecture.md",
    "dart-standards.md",
    "ui-design.md",
    "color-intelligence.md",
    "color-preview.md",
    "design-system.md",
    "shared-components.md",
    "feature-engineering.md",
    "state-management.md",
    "responsive-design.md",
    "animations.md",
    "performance.md",
    "navigation.md",
    "api-integration.md",
    "database-storage.md",
    "firebase.md",
    "platform-integration.md",
    "accessibility.md",
    "security.md",
    "testing.md",
    "debugging.md",
    "refactoring.md",
    "build-release.md",
    "design-audit.md",
    "code-review.md",
    "project-audit.md",

    # Supplementary & Backward-Compatible Modules
    "animation.md",
    "file-structure.md",
    "color-system.md",
    "components.md",
    "typography.md",
    "workflow.md"
]

def main():
    print("==================================================")
    print(" Human Flutter Engineering — Structural Validator ")
    print("==================================================")

    errors = []

    # 1. Verify Agent Entry Points
    print("\n[1/3] Verifying Agent Entry Points reference canonical instructions...")
    for entry_rel, expected_ref in AGENT_ENTRIES:
        entry_path = os.path.join(REPO_ROOT, entry_rel)
        if not os.path.exists(entry_path):
            errors.append(f"Missing agent entry file: {entry_rel}")
            continue

        with open(entry_path, "r", encoding="utf-8") as fh:
            content = fh.read()

        if expected_ref not in content:
            errors.append(f"Agent entry {entry_rel} does not reference {expected_ref}")
        else:
            print(f"  ✓ {entry_rel} correctly references {expected_ref}")

    # 2. Verify Canonical Skill YAML Frontmatter
    print("\n[2/3] Checking Canonical Skill YAML Frontmatter...")
    skill_path = os.path.join(REPO_ROOT, "skills/human-flutter/SKILL.md")
    if not os.path.exists(skill_path):
        errors.append("Missing skills/human-flutter/SKILL.md!")
    else:
        with open(skill_path, "r", encoding="utf-8") as fh:
            content = fh.read()
        if not content.startswith("---") or "name: human-flutter" not in content:
            errors.append("skills/human-flutter/SKILL.md missing valid YAML frontmatter with 'name: human-flutter'")
        else:
            print("  ✓ skills/human-flutter/SKILL.md frontmatter verified (name: human-flutter)")

    # 3. Verify Dedicated Flutter Reference Modules
    print(f"\n[3/3] Verifying {len(EXPECTED_REFERENCES)} Dedicated Flutter Reference Modules...")
    refs_dir = os.path.join(REPO_ROOT, "skills/human-flutter/references")
    if not os.path.exists(refs_dir):
        errors.append("Missing skills/human-flutter/references directory!")
    else:
        for ref_file in EXPECTED_REFERENCES:
            ref_path = os.path.join(refs_dir, ref_file)
            if not os.path.exists(ref_path):
                errors.append(f"Missing reference module: {ref_file}")
            elif os.path.getsize(ref_path) < 50:
                errors.append(f"Reference module is empty/too small: {ref_file}")
            else:
                print(f"  ✓ Reference verified: {ref_file}")

    if errors:
        print(f"\n❌ FAILED with {len(errors)} error(s):")
        for err in errors:
            print(f"  - {err}")
        return 1
    else:
        print("\n✅ ALL STRUCTURAL CHECKS PASSED!")
        return 0

if __name__ == "__main__":
    sys.exit(main())
