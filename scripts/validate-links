#!/usr/bin/env python3
"""
Human UI Engineering — Relative Link Validator
Scans all Markdown (.md) and Cursor rule (.mdc) files to verify that all
relative internal links resolve to existing files on disk.
"""

import os
import re
import sys

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

def main():
    print("==================================================")
    print(" Human UI Engineering — Relative Link Validator   ")
    print("==================================================")

    link_pattern = re.compile(r'\[([^\]]+)\]\(([^)]+)\)')
    total_links = 0
    scanned_files = 0
    errors = []

    for root, dirs, files in os.walk(REPO_ROOT):
        # Exclude git internals
        if ".git" in root.split(os.sep):
            continue
        for f in files:
            if f.endswith(".md") or f.endswith(".mdc"):
                scanned_files += 1
                rel_file = os.path.relpath(os.path.join(root, f), REPO_ROOT)
                full_file = os.path.join(root, f)
                dir_path = os.path.dirname(full_file)

                with open(full_file, "r", encoding="utf-8") as fh:
                    content = fh.read()

                matches = link_pattern.findall(content)
                for text, link in matches:
                    # Ignore absolute external URLs, mailto, anchor-only links
                    if link.startswith("http://") or link.startswith("https://") or link.startswith("mailto:") or link.startswith("#"):
                        continue

                    total_links += 1
                    clean_link = link.split("#")[0]
                    if not clean_link:
                        continue

                    target_path = os.path.normpath(os.path.join(dir_path, clean_link))
                    if not os.path.exists(target_path):
                        errors.append(f"BROKEN LINK in {rel_file}: '{link}' -> Target '{target_path}' does not exist")

    print(f"\nScanned {scanned_files} documentation files.")
    print(f"Validated {total_links} relative internal links.")

    if errors:
        print(f"\n❌ LINK VALIDATION FAILED with {len(errors)} error(s):")
        for err in errors:
            print(f"  - {err}")
        return 1
    else:
        print(f"  ✓ 100% of internal links ({total_links}) resolve cleanly.")
        print("\n✅ ALL LINKS VERIFIED PERFECTLY!")
        return 0

if __name__ == "__main__":
    sys.exit(main())

